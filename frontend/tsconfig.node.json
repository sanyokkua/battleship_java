{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": [
        "vite.config.ts",
        "vitest.config.ts",
        "playwright.config.ts",
        "e2e/**/*.ts",
        "src/contract/generated/api.ts",
        "src/i18n/en.ts",
        "src/i18n/uk.ts",
        "src/i18n/translate.ts"
    ]
}
