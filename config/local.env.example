# Local-only configuration. Copy values into your shell environment as needed.
FRONTEND_PORT=5173
BACKEND_PORT=8080

# battleship.* values match backend/app/src/main/resources/application.yaml.
BATTLESHIP_IDLETIMEOUTSECONDS=900
BATTLESHIP_MAXGAMEDURATIONSECONDS=7200
BATTLESHIP_RESULTRETENTIONSECONDS=300
BATTLESHIP_INVITATIONLIFETIMESECONDS=900
BATTLESHIP_PRESENCEINTERVALSECONDS=300
BATTLESHIP_HEARTBEATSECONDS=15
BATTLESHIP_STREAMMAXLIFETIMESECONDS=1200
BATTLESHIP_MAXCONCURRENTGAMES=100
BATTLESHIP_MAXCONCURRENTSTREAMS=200
BATTLESHIP_MAXLIVEGAMESPERBROWSER=1
BATTLESHIP_MAXREQUESTBODYBYTES=16384
BATTLESHIP_RANDOMARRANGEMENTATTEMPTS=1000
BATTLESHIP_SWEEPINTERVALSECONDS=30
BATTLESHIP_SHUTDOWNDRAINSECONDS=5
BATTLESHIP_PUBLICBASEURL=http://localhost:5173
BATTLESHIP_RATELIMIT_CREATEGAMEPERMINUTE=5
BATTLESHIP_RATELIMIT_JOINPERMINUTE=20
BATTLESHIP_RATELIMIT_COMMANDSPERMINUTE=60
BATTLESHIP_RATELIMIT_READGAMEPERMINUTE=120
BATTLESHIP_RATELIMIT_PRESENCEPERMINUTE=30
BATTLESHIP_RATELIMIT_STREAMOPENPERMINUTE=30
BATTLESHIP_RATELIMIT_REPLACEINVITATIONPERMINUTE=10
BATTLESHIP_RATELIMIT_LEAVEPERMINUTE=10
